# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CHANNEL_ID=1341725863535710218

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# Redis (Railway addon provides this)
REDIS_URL=redis://default:password@host:6379

# Internal Impetus API
IMP_ENGINE_URL=https://impetus-dota2-production.up.railway.app

# Steam Web API key (optional, recommended): detects new matches within
# about a minute. Get one at https://steamcommunity.com/dev/apikey
# STEAM_API_KEY=your_steam_web_api_key_here
# STEAM_POLL_INTERVAL_SECONDS=60

# Live tracking (Dota 2 Game State Integration). The bot serves POST /gsi on
# $PORT; players get their config file with the /dota-live-setup command.
# GSI_PUBLIC_URL defaults to Railway's public domain when one is generated.
# GSI_ENABLED=true
# GSI_PUBLIC_URL=https://your-bot.up.railway.app
# GSI_MAX_MOMENTS=12

# OpenDota polling interval (seconds). Keep at 600: OpenDota's free tier
# cannot sustain much more for 6 players.
POLL_INTERVAL_SECONDS=600

# YouTube API (for daily educational videos)
YOUTUBE_API_KEY=your_youtube_api_v3_key_here
YOUTUBE_POST_HOUR_GMT=21

# Email notifications (optional - for error alerts)
# SMTP_SERVER=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your_smtp_user
# SMTP_PASSWORD=your_smtp_password
# SMTP_FROM_EMAIL=professor@impetus.com

